#!/usr/bin/env bash
# loose-ends-scan: report unfinished work across every git repository under a set
# of roots, as one JSON object on stdout.
#
# WHY A SCRIPT AND NOT QML
#   Walking a filesystem and shelling out to git is not something a compositor
#   should be doing inline. This runs as one bounded process, emits JSON, and the
#   QML side only ever parses. The parse layer is Model.js, which node can load,
#   so the whole display path unit-tests without a shell.
#
# WHY NO NETWORK
#   There is none, by construction. Every fact here comes from the local
#   filesystem and from git plumbing. No API, no token, no host to validate.
#   That is deliberate: the last plugin in this set that accepted a user-supplied
#   URL spent three review rounds on it and ended up deleting the feature.
#
# SAFETY
#   * Roots are canonicalised with realpath and any root that is not a directory
#     is dropped. A root that resolves outside itself cannot happen because the
#     resolved path IS the root we then confine to.
#   * find is given -xdev so a scan cannot wander onto another filesystem, and
#     -maxdepth so a deep tree cannot cost unbounded time.
#   * Symlinks are not followed: find without -L, plus an explicit -type d test.
#   * Every git invocation carries --no-optional-locks so reading a repository
#     never writes to it. Without that, git can refresh the index and mutate a
#     repo the user did not ask us to touch.
#   * git is run with a fixed argv. No user string is ever interpolated into a
#     command line, which is what gate c34 checks for.
#
# Usage: loose-ends-scan [--max-depth N] [--stash-age-days N] ROOT [ROOT...]
set -uo pipefail
export LC_ALL=C
# git respects a lot of environment. Pin the ones that change output shape.
export GIT_PAGER=cat GIT_TERMINAL_PROMPT=0 GIT_OPTIONAL_LOCKS=0 GIT_CONFIG_NOSYSTEM=1

MAXDEPTH=4
STASH_AGE_DAYS=7
JOBS=0            # 0 = auto, one per core capped at 4 (was 16; marketplace review #2899)
MAX_REPOS=256      # hard cap protects the long-lived QML reader and panel
ONE=""            # internal: scan exactly one repo and exit
ROOTS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --max-depth)      MAXDEPTH="${2:-4}"; shift 2 ;;
    --stash-age-days) STASH_AGE_DAYS="${2:-7}"; shift 2 ;;
    --jobs)           JOBS="${2:-0}"; shift 2 ;;
    --max-repos)      MAX_REPOS="${2:-256}"; shift 2 ;;
    --one)            ONE="${2:-}"; shift 2 ;;
    --) shift; break ;;
    -*) shift ;;
    *)  ROOTS+=("$1"); shift ;;
  esac
done

case "$MAXDEPTH" in ''|*[!0-9]*) MAXDEPTH=4 ;; esac
case "$STASH_AGE_DAYS" in ''|*[!0-9]*) STASH_AGE_DAYS=7 ;; esac
case "$JOBS" in ''|*[!0-9]*) JOBS=0 ;; esac
case "$MAX_REPOS" in ''|*[!0-9]*) MAX_REPOS=256 ;; esac
[ "$MAX_REPOS" -lt 1 ] && MAX_REPOS=256
[ "$MAX_REPOS" -gt 256 ] && MAX_REPOS=256
[ "$MAXDEPTH" -gt 8 ] && MAXDEPTH=8
[ "$STASH_AGE_DAYS" -gt 3650 ] && STASH_AGE_DAYS=3650
if [ "$JOBS" -le 0 ]; then
  JOBS=$(nproc 2>/dev/null || echo 4)
fi
[ "$JOBS" -gt 4 ] && JOBS=4

NOW=$(date +%s)

emit_head() { printf '{"generatedAt":%s,"repoTotal":%s,"truncated":%s,"repos":[' "$NOW" "$1" "$2"; }
emit_tail() { printf ']}\n'; }

# --one carries no roots by design, so this guard must not swallow it.
if [ -z "$ONE" ] && [ "${#ROOTS[@]}" -eq 0 ]; then
  emit_head 0 false; emit_tail; exit 0
fi

json_escape() {
  # Escape for a JSON string. Parameter expansion retains a literal newline;
  # line-oriented sed cannot, which previously yielded invalid JSON for a
  # legally named repository containing one.
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\t'/\\t}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  printf '%s' "$value" | tr -d '\000-\010\013\014\016-\037'
}

# ---------------------------------------------------------------- one repo
# Emits ONE json object, or nothing when the repo has no loose ends. Invoked
# directly by the outer loop through xargs -P, which is why it is a separate
# mode rather than a shell function: exporting functions is bash-only and
# breaks the moment /bin/sh is dash.
scan_one() {
  local rrepo="$1"
  [ -d "$rrepo" ] || return 0

  # EVERY git invocation is budgeted in time and output bytes, and runs with
  # execution-capable repository configuration explicitly disabled. The repos
  # under scan are DATA, not trusted workspaces: GIT_OPTIONAL_LOCKS=0 stops
  # optional index writes but does not make repo-local config inert, and
  # `git status` will happily invoke a configured core.fsmonitor hook, which
  # turns "read-only scan of a copied repository" into "execute code the
  # repository chose" (marketplace review #2899). Command-line -c has the
  # highest config precedence, so the repo cannot override these back on.
  rungit() { # <max_output_bytes> <git args...>
    local cap="$1"; shift
    timeout 5 git --no-optional-locks \
      -c core.fsmonitor=false -c core.untrackedCache=false -c core.hooksPath=/dev/null \
      -C "$rrepo" "$@" 2>/dev/null | head -c "$cap" || true
  }

  local branch detached
  branch=$(rungit 4096 symbolic-ref --quiet --short HEAD)
  detached=false
  if [ -z "$branch" ]; then
    detached=true
    branch=$(rungit 4096 rev-parse --short HEAD); [ -n "$branch" ] || branch="unknown"
  fi
  branch="${branch:0:200}"

  local status_out dirty
  # 256 KiB of porcelain is thousands of paths; an adversarial repo with more
  # gets counted against the truncated capture rather than buffered whole.
  status_out=$(rungit 262144 status --porcelain --untracked-files=normal)
  dirty=$(printf '%s' "$status_out" | grep -c . || true)
  case "$dirty" in ''|*[!0-9]*) dirty=0 ;; esac

  # Newest mtime among modified files: how long since this was touched. Capped
  # at 40 files on purpose. If more than 40 files are modified you are plainly
  # working in there right now, and the exact newest mtime stops mattering.
  local touched=0 f m
  if [ "$dirty" -gt 0 ]; then
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      [ -e "$rrepo/$f" ] || continue
      m=$(stat -c %Y -- "$rrepo/$f" 2>/dev/null || echo 0)
      [ "$m" -gt "$touched" ] && touched=$m
    done <<< "$(printf '%s' "$status_out" | cut -c4- | head -40)"
  fi

  local ahead=0 ahead_age=0 upstream oldest
  upstream=$(rungit 4096 rev-parse --abbrev-ref --symbolic-full-name '@{upstream}')
  if [ -n "$upstream" ]; then
    ahead=$(rungit 64 rev-list --count "$upstream"..HEAD); [ -n "$ahead" ] || ahead=0
    case "$ahead" in ''|*[!0-9]*) ahead=0 ;; esac
    if [ "$ahead" -gt 0 ]; then
      oldest=$(rungit 65536 log --format=%ct "$upstream"..HEAD | tail -1)
      case "$oldest" in ''|*[!0-9]*) oldest=0 ;; esac
      [ "$oldest" -gt 0 ] && ahead_age=$(( NOW - oldest ))
    fi
  fi

  local stale_stash=0 stash_age=0 ts age
  while IFS= read -r ts; do
    case "$ts" in ''|*[!0-9]*) continue ;; esac
    age=$(( NOW - ts ))
    if [ "$age" -gt $(( STASH_AGE_DAYS * 86400 )) ]; then
      stale_stash=$(( stale_stash + 1 ))
      [ "$age" -gt "$stash_age" ] && stash_age=$age
    fi
  done <<< "$(rungit 65536 stash list --format=%ct)"

  local interrupted="" gd
  gd=$(rungit 4096 rev-parse --git-dir)
  if [ -n "$gd" ]; then
    case "$gd" in /*) ;; *) gd="$rrepo/$gd" ;; esac
    if [ -d "$gd/rebase-merge" ] || [ -d "$gd/rebase-apply" ]; then interrupted="rebase"; fi
    [ -f "$gd/MERGE_HEAD" ] && interrupted="merge"
    [ -f "$gd/CHERRY_PICK_HEAD" ] && interrupted="cherry-pick"
    [ -f "$gd/BISECT_LOG" ] && interrupted="bisect"
  fi

  # A clean, pushed, unstashed repo on a branch has nothing to say. Say nothing.
  if [ "$dirty" -eq 0 ] && [ "$ahead" -eq 0 ] && [ "$stale_stash" -eq 0 ] \
     && [ -z "$interrupted" ] && [ "$detached" = false ]; then
    return 0
  fi

  local dirty_age=0
  [ "$touched" -gt 0 ] && dirty_age=$(( NOW - touched ))

  printf '{"path":"%s","name":"%s","branch":"%s","detached":%s,"dirty":%s,"dirtyAge":%s,"ahead":%s,"aheadAge":%s,"staleStash":%s,"stashAge":%s,"interrupted":"%s"}\n' \
    "$(json_escape "${rrepo:0:1024}")" \
    "$(json_escape "$(basename -- "$rrepo")")" \
    "$(json_escape "$branch")" \
    "$detached" "$dirty" "$dirty_age" "$ahead" "$ahead_age" \
    "$stale_stash" "$stash_age" \
    "$(json_escape "$interrupted")"
}

if [ -n "$ONE" ]; then
  scan_one "$ONE"
  exit 0
fi

# ---------------------------------------------------------------- all roots
# Collect the repo list first, confine it, then fan out. Serial scanning of ~180
# repos took two minutes on the author's box, which is longer than the poll
# interval and therefore not shippable. Fanning out across cores brings it to
# single-digit seconds.
self="$0"
# The enumeration itself is budgeted BEFORE anything is stored or sorted. The
# old shape (find | ... | sort -zu, cap applied afterwards) meant sort had
# already enumerated, stored and sorted every matching .git under the roots
# before MAX_REPOS limited anything, so a huge or adversarial tree cost real
# CPU, memory and disk on every five-minute scan (marketplace review #2899).
# head -z between find and the rest SIGPIPE-terminates find the moment the
# entry budget is reached, the per-root timeout bounds the walk in time, and a
# second aggregate head caps what sort can ever see across all roots. Hitting
# the budget marks the result truncated rather than pretending completeness.
ENUM_BUDGET=$(( MAX_REPOS * 4 ))
repos=()
while IFS= read -r -d '' repo; do
  repos+=("$repo")
done < <({
  for raw_root in "${ROOTS[@]}"; do
    root=$(realpath -e -- "$raw_root" 2>/dev/null) || continue
    [ -d "$root" ] || continue
    timeout 20 find "$root" -xdev -maxdepth "$MAXDEPTH" -type d -name .git -print0 2>/dev/null \
      | head -z -n "$ENUM_BUDGET" \
      | while IFS= read -r -d '' gitdir; do
      repo=$(dirname -- "$gitdir")
      rrepo=$(realpath -e -- "$repo" 2>/dev/null) || continue
      # Confinement: the RESOLVED repo must still live under the RESOLVED root.
      case "$rrepo/" in "$root"/*) printf '%s\0' "$rrepo" ;; esac
    done
  done | head -z -n "$ENUM_BUDGET" | sort -zu
})
repo_total=${#repos[@]}
truncated=false
[ "$repo_total" -gt "$MAX_REPOS" ] && truncated=true
# At the enumeration budget we cannot know what the walk never saw; say so.
[ "$repo_total" -ge "$ENUM_BUDGET" ] && truncated=true

emit_head "$repo_total" "$truncated"
if [ "$repo_total" -gt 0 ]; then
  printf '%s\0' "${repos[@]:0:MAX_REPOS}" \
    | xargs -r -0 -P "$JOBS" -I{} "$self" --stash-age-days "$STASH_AGE_DAYS" --one {} \
    | paste -sd, -
fi
printf ']}\n'
